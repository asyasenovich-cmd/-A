@startuml
skinparam classAttributeIconSize 0

' --- Иерархия персонажей ---
abstract class Персонаж {
    + имя: String
    + здоровье: int
}

class Иван extends Персонаж {
    + здоровье = 100
    + состояние: String = "Обычный"
    + прыгнутьВКотел(котел: Котел)
}

class КонёкГорбунок extends Персонаж {
    + мана = 100
    + наложитьЗащиту(цель: Иван, тип: String)
}

class Царь extends Персонаж {
    + здоровье = 100
    + состояние: String = "Царь"
}

' --- Иерархия баффов ---
abstract class Бафф {
    + название: String
    + длительность: int
    + защита: int
    + применить(цель: Иван)
}

class ВодныйБафф extends Бафф {
    + название = "ВоднаяЗащита"
    + длительность = 3
    + защита = 50
}

class МолочныйБафф extends Бафф {
    + название = "МолочнаяЗащита"
    + длительность = 3
    + защита = 50
}

class КипяточныйБафф extends Бафф {
    + название = "ОгненнаяЗащита"
    + длительность = 3
    + защита = 100
}

' --- Иерархия котлов ---
abstract class Котел {
    + температура: int
    + тип: String
    + воздействовать(цель: Иван)
}

class КотелСВодой extends Котел {
    + температура = 40
    + тип = "Вода"
}

class КотелСМолоком extends Котел {
    + температура = 60
    + тип = "Молоко"
}

class КотелСКипятком extends Котел {
    + температура = 100
    + тип = "Кипяток"
}

' --- Контроллер ---
class КонёкГорбунок {
    + призвать(): Бафф
    + управлятьИспытаниями()
}

' СВЯЗИ
КонёкГорбунок ..> Бафф : <<create>>
КонёкГорбунок --> Иван : защищает >
Иван "1" -- "0..3" Котел : прыгает >

note right of КонёкГорбунок::наложитьЗащиту
  **Factory Method**
  if (тип == "вода")
    return new ВодныйБафф()
  else if (тип == "молоко")
    return new МолочныйБафф()
  else
    return new КипяточныйБафф()
end note

note bottom of Царь
  Царь — это состояние Ивана
  после успешного прохождения
  всех трёх котлов.
end note

@enduml
