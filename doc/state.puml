@startuml
skinparam state {
  BackgroundColor<<Protected>> #lightblue
  BackgroundColor<<Victory>> #lightgreen
  BackgroundColor<<Dead>> #pink
}

title Жизненный цикл Ивана (здоровье 100)

[*] --> Обычный : <<create>>

state "Обычный" as Обычный
state "Под защитой" as ПодЗащитой <<Protected>>
state "Прекрасный царь" as ПрекрасныйЦарь <<Victory>>
state "Погиб" as Погиб <<Dead>>
state c <<choice>> 

' Наложение защиты
Обычный --> ПодЗащитой : наложитьЗащиту(тип)

' Прыжок в котёл
ПодЗащитой --> c : прыгнутьВКотел(температура)

' Логика распределения потоков
c --> Обычный : [температура - защита < 0 && котёл не последний] \n (Вода)
c --> Обычный : [температура - защита >= 0 && котёл не последний] \n (Молоко, урон 10)
c --> ПрекрасныйЦарь : [температура - защита < 0 && котёл последний] \n (Кипяток)
c --> Погиб : [здоровье <= 0]

' Финал
ПрекрасныйЦарь --> [*] : <<victory>>
Погиб --> [*] : <<destroy>>

note left of c
  **Точка выбора (Choice)**
  Проверяет условие:
  - Выжил ли Иван?
  - Это последний котёл?
end note

note right of ПодЗащитой
  Состояние после
  наложения баффа
  Коньком-Горбунком
end note

note bottom of ПрекрасныйЦарь
  Иван прошёл все
  три испытания и
  стал царём
end note

@enduml
